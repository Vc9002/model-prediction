    "winner_gate": {
      "location": "learned_forward.py:511, forward.py:148-149",
      "rule": "selection = side with higher calibrated model probability"
    },
    "value_gate": {
      "primary": "eligibility.py:_call_result():279",
      "secondary": "units.py:edge_scaled_units():85-86",
      "tertiary": "cli.py:_forecast_learned_sport:1395, cli.py:_forecast_mlb:813",
      "formula": "cost_adjusted_edge = (model_prob - uncertainty) - market_ask - fees - expected_slippage",
      "threshold": "policy.min_edge (default 0.02)",
      "failure": "NO_CALL_WINNER_OVERVALUED, 0 units"
    },
    "config": {
      "fees": 0.0,
      "expected_slippage": 0.01,
      "min_edge": 0.02
    }
