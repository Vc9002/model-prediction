THE_ODDS_API_KEY=
SPORTSDATAIO_API_KEY=
MODEL_PREDICTION_CONFIG=config/model.yaml
POLYMARKET_KEY_ID=
POLYMARKET_SECRET_KEY=
POLYMARKET_PRIVATE_KEY=
POLYMARKET_WALLET_ADDRESS=
# This repository currently targets the separate Polymarket US product.
POLYMARKET_PLATFORM=us
# International-only Combo RFQ credentials. Polymarket US has no documented
# combo/RFQ endpoint; leave these blank for the US integration.
POLYMARKET_BUILDER_API_KEY=
POLYMARKET_BUILDER_SECRET=
POLYMARKET_BUILDER_PASSPHRASE=

# Soccer results feed (api-football.com / api-sports.io v3, free tier = 100 req/day)
API_FOOTBALL_KEY=

# NCAAB research: Barttorvik ratings via the cbbdata API (cbbdata.com). Key, or username+password for login.
CBBDATA_API_KEY=
CBBDATA_USERNAME=
CBBDATA_PASSWORD=

# NCAAB research: CollegeBasketballData.com (api.collegebasketballdata.com), Bearer key; quota shared with CFBD.
CBBD_API_KEY=
